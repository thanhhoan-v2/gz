{
  "name": "@adrian_phan/gz",
  "version": "1.0.2",
  "description": "Interactive Git workflow CLI tool",
  "type": "module",
  "bin": {
    "gz": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrian-phan/gz.git"
  },
  "bugs": {
    "url": "https://github.com/adrian-phan/gz/issues"
  },
  "homepage": "https://github.com/adrian-phan/gz#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "install-global": "pnpm run build && npm install -g .",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "git",
    "cli",
    "terminal",
    "workflow",
    "interactive"
  ],
  "author": "Adrian Phan",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "conf": "^13.0.1",
    "execa": "^9.5.2",
    "fuzzy": "^0.1.3",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
