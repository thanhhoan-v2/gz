    "react": "^18.3.1",
    "execa": "^9.5.2",
    "fuzzy": "^0.1.3",
    "conf": "^13.0.1",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
