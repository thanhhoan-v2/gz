{
  "name": "gz",
  "version": "1.0.0",
  "description": "Interactive Git workflow CLI tool",
  "type": "module",
  "bin": {
    "gz": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
